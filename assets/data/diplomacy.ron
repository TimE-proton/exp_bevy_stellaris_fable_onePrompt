// Diplomatie: Hebel und die vier Grundhaltungen.
//
// Jede KI-Gemeinschaft folgt einer verborgenen Mischung der vier Grundhaltungen. Sie
// beginnt mit einer davon als Schwerpunkt (anchor_main, die übrigen je anchor_rest) und
// treibt unter öffentlichem Druck (Verflechtung, Gelegenheit, Bedrohung, Knappheit) davon
// weg (drift), zieht aber zu ihrem Anker zurück (anchor_weight). Beobachter kennen nur die
// reinen Profile unten und messen jede öffentliche Tat daran: Ihre Einschätzung ist ein
// Schluss aus Taten, nie ein Blick in die Führung.
//
// Utilitäten (siehe crates/sim/src/diplomacy/occasion.rs):
//   Zuschlagen = (grab·Beute·(1+Not) + prevent·Fenster)·Sieg − Abhängigkeit
//                − honor·(Stufen/5 + Waffenruhe) − Kriegsmüdigkeit/100
//   Binden     = merge·(Fenster + Abhängigkeit + Nähe)·Vertrauen + prevent·gemeinsame
//                Bedrohung − 0,6·(1−Not)·(1−Fenster)
//   Wahl       = Softmax(Nutzen / temperature); verlockt nichts (alles unter act), bleibt
//                jeder Wahl nur tremble.
(
    levers: (
        act: 0.15,
        temperature: 0.05,
        tremble: 0.002,
        anchor_main: 0.70,
        anchor_rest: 0.10,
        // Jede Gemeinschaft zieht ihre Grundhaltung für sich: kooperativ, opportunistisch,
        // misstrauisch, expansionistisch.
        anchor_draw: (1.0, 1.0, 1.0, 1.0),
        anchor_weight: 1.0,
        drift: 0.04,
        def_adv: 0.8,
        minor_share: 0.06,
        leader_share: 0.40,
        trend_months: 60.0,
        tension_adjust: 0.08,
        grievance_decay: 0.03,
        half_life_months: 60.0,
        surprise_break: 1.2,
        notice_days: 180,
        proposal_days: 60,
        refusal_block_days: 360,
        peace_block_days: 90,
        // Eine abgelehnte Vereinigung wird erst nach Jahren wieder angetragen.
        merge_block_days: 1800,
        answer_days: (3, 10),
        // Handel, Nichtangriff, Forschung, Investition, Verteidigung, Union
        rung_cost: (0.2, 0.4, 0.5, 0.6, 1.2, 1.8),
        merge_union_months: 144,
        // Gemessen: Die Verflechtung benachbarter Partner liegt nach Jahrzehnten unter
        // Union und Anteilstausch bei 0,02 bis 0,07.
        merge_tie: 0.04,
        // Spannung und Druck auf die Haltung messen die Verflechtung bis zu diesem Wert.
        tie_scale: 0.15,
        merge_affinity: 0.82,
        // Bei voller Not beider genügt weniger Nähe: Wo niemand mehr wachsen kann,
        // rücken auch Fremde zusammen.
        affinity_relief: 0.12,
        merge_hold_months: 12,
        lead_cost: 3.0,
        vassal_tribute: 0.15,
        protectorate_tribute: 0.05,
        reparations: 0.10,
        terms_years: 10,
        terms_tribute: 20.0,
        terms_subjugate: 40.0,
        max_cede: 3,
        // Frist eines Krieges: Danach diktiert der Vorsprung den Frieden (über 15 Jahre,
        // damit die Kriege des Drehbuchs „feldzug“ ihr Ende nach Plan erreichen).
        war_max_months: 192,
        exhaustion: 85.0,
        score_weights: (120.0, 35.0, 10.0),
        peace_min_months: 6,
        breach_shock: 0.9,
        research_bonus: 0.10,
        clue_weight: (opening: 1.5, answer: 0.8, terms: 1.0, continuous: 0.6),
        clues_kept: 16,
        acts_kept: 256,
        continuous_evidence: false,
        // Die KI trägt selbst Bindungen an und plant Kriege (nach der Gründerzeit).
        ai_openings: true,
        // Die KI bietet im Krieg selbst Frieden an oder fordert Bedingungen. Kriege, die
        // ein Drehbuch erklärt hat, beendet nur das Drehbuch (oder das Diktat).
        ai_peace_offers: true,
        // Geschlossene Grenzen: Flotten brauchen fremdes Gebiet Durchfahrt (eigener
        // Verbund, Verbündete, Krieg oder gewährte Durchfahrt). Bleibt aus, bis die
        // militärische Führung der KI ihre Wege danach plant.
        closed_borders: false,
        // Gründerzeit: In den ersten Jahrzehnten besiedeln die Gemeinschaften nur.
        founding_years: 40,
        // Zuschlagen: Vorbereitung, Gültigkeit des Plans, geringste Siegaussicht.
        prep_days: 180,
        plan_years: 2,
        strike_win: 0.30,
        // In der Not wagt eine Gemeinschaft mehr: Die geringste Siegaussicht sinkt bis auf
        // die Hälfte.
        want_boldness: 0.5,
        mobilize_factor: 1.5,
        // Not aus Enge (Jahre ohne freie Welt) und aus Knappheit (erschöpfte Vorkommen).
        crowding_years: 100.0,
        crowding_weight: 1.0,
        scarcity_weight: 1.0,
        // Wer sich bindet, tauscht Anteile in Tranchen dieses Anteils am Marktwert der
        // Betriebe der kleineren Seite.
        swap_tranche: 0.02,
        status_quo_months: 12,
        shelter_act: 0.15,
        // Ein Feldzug mit dem Ziel der Unterwerfung sucht die Hauptwelt des Gegners.
        aim_capital_bonus: 3.0,
        // Kulturen gleichen sich an, wo Handel und Union verbinden.
        contact_rate: 0.02,
        // Vertrauen wächst langsam: Jede Stufe muss Jahre halten, bevor die nächste folgt.
        rung_hold_months: 48,
        // Wer wenig auf Verbindung gibt, führt keine Vereinigung: Er wächst durch Krieg.
        merge_lead_min: 0.40,
        contact_trade: 0.2,
        contact_union: 1.5,
    ),
    archetypes: [
        (key: "kooperativ", label: "kooperativ",
         arm0: 0.08, arm1: 0.15, forward: 0.15, grab: 0.05, prevent: 0.15, merge: 1.0,
         honor: 1.0, spread: 0.9, open: 0.9, patience: 25.0, caution: 0.5),
        (key: "opportunistisch", label: "opportunistisch",
         arm0: 0.12, arm1: 0.20, forward: 0.40, grab: 0.8, prevent: 0.2, merge: 0.5,
         honor: 0.25, spread: 0.5, open: 0.7, patience: 8.0, caution: 0.3),
        (key: "misstrauisch", label: "misstrauisch",
         arm0: 0.22, arm1: 0.45, forward: 0.10, grab: 0.1, prevent: 1.0, merge: 0.25,
         honor: 0.7, spread: 0.3, open: 0.15, patience: 12.0, caution: 0.9),
        (key: "expansionistisch", label: "expansionistisch",
         arm0: 0.25, arm1: 0.20, forward: 0.70, grab: 1.0, prevent: 0.5, merge: 0.15,
         honor: 0.5, spread: 0.1, open: 0.5, patience: 15.0, caution: 0.2),
    ],
)
